diff --git a/src/ssh_project.rs b/src/ssh_project.rs
new file mode 100644
index 0000000..5186d4b
--- /dev/null
+++ b/src/ssh_project.rs
@@ -0,0 +1,140 @@
+//! Project paths reached by the local OpenSSH client.
+use serde_json::{Value, json};
+
+pub const AGENTS: &[(&str, &[&str])] = &[
+    ("claude", &["claude"]),
+    ("codex", &["codex", "--no-daemon"]),
+    ("codebuddy-code", &["codebuddy"]),
+    ("pi", &["pi"]),
+    ("pig", &["pig"]),
+    ("opencode", &["opencode"]),
+    ("cursor", &["cursor-agent"]),
+    ("copilot", &["copilot"]),
+    ("gemini", &["gemini"]),
+    ("qoder", &["qodercli"]),
+    ("dsh-tui", &["dsh", "--profile", "dsh-tui"]),
+    ("amp", &["amp"]),
+    ("antigravity", &["agy"]),
+    ("kimi", &["kimi"]),
+    ("kiro", &["kiro-cli"]),
+    ("hermes", &["hermes"]),
+    ("crush", &["crush"]),
+    ("grok", &["grok"]),
+];
+
+pub struct Project {
+    pub folder: String,
+    host: String,
+}
+
+impl Project {
+    pub fn parse(value: &Value) -> Result<Self, String> {
+        let host = value
+            .get("host")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .trim();
+        if host.is_empty()
+            || host.starts_with('-')
+            || host.len() > 255
+            || !host
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"@._-:[]".contains(&b))
+        {
+            return Err("Enter an SSH config alias, hostname, or user@host".into());
+        }
+        let folder = value
+            .get("folder")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .trim();
+        if !folder.starts_with('/') || folder.chars().any(char::is_control) {
+            return Err("Enter an absolute POSIX path on the SSH host".into());
+        }
+        Ok(Self {
+            host: host.into(),
+            folder: folder.into(),
+        })
+    }
+
+    pub fn as_json(&self) -> Value {
+        json!({ "host": self.host, "folder": self.folder })
+    }
+
+    pub fn argv(&self, command: Option<&[String]>, create: bool) -> Vec<String> {
+        let folder = quote(&self.folder);
+        let mut script = String::new();
+        if create {
+            script.push_str(&format!("mkdir -p {folder} && "));
+        }
+        script.push_str(&format!("cd {folder} && "));
+        if let Some(command) = command {
+            script.push_str("exec ");
+            let command = crate::remote_shell::launch(command.to_vec());
+            script.push_str(
+                &command
+                    .iter()
+                    .map(|arg| quote(arg))
+                    .collect::<Vec<_>>()
+                    .join(" "),
+            );
+        } else {
+            script.push_str(r#"exec "${SHELL:-/bin/sh}" -i"#);
+        }
+        let remote = format!("sh -c {}", quote(&script));
+        vec![
+            "ssh".into(),
+            "-tt".into(),
+            "--".into(),
+            self.host.clone(),
+            remote,
+        ]
+    }
+}
+
+fn quote(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+pub fn agent_command(key: &str, task: Option<&str>) -> Result<Vec<String>, String> {
+    let argv = AGENTS
+        .iter()
+        .find(|(agent, _)| *agent == key)
+        .map(|(_, argv)| *argv)
+        .ok_or_else(|| format!("No SSH launcher for agent {key:?}"))?;
+    let mut command: Vec<String> = argv.iter().map(|s| (*s).into()).collect();
+    if let Some(task) = task.filter(|task| !task.trim().is_empty()) {
+        command.push(task.into());
+    }
+    Ok(command)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[cfg(unix)]
+    #[test]
+    fn remote_argument_boundaries_are_preserved() {
+        let root = std::env::temp_dir().join(format!("herdr-ssh-{}-a ' $b", std::process::id()));
+        let p = Project::parse(&json!({"host":"user@server","folder":root})).unwrap();
+        let command = ["/usr/bin/printf", "argument=<%s>\n", "$(literal) ' x"].map(String::from);
+        let argv = p.argv(Some(&command), true);
+        assert_eq!(&argv[..4], ["ssh", "-tt", "--", "user@server"]);
+        let output = std::process::Command::new("/bin/sh")
+            .args(["-c", &argv[4]])
+            .env("SHELL", "/bin/sh")
+            .stdin(std::process::Stdio::null())
+            .output()
+            .unwrap();
+        std::fs::remove_dir(root).unwrap();
+        assert!(String::from_utf8_lossy(&output.stdout).contains("argument=<$(literal) ' x>"));
+    }
+
+    #[test]
+    fn rejects_options_and_missing_absolute_paths() {
+        assert!(Project::parse(&json!({"host":"-oBadOption","folder":"/somewhere"})).is_err());
+        assert!(Project::parse(&json!({"host":"server","folder":"relative/path"})).is_err());
+        assert!(agent_command("custom", None).is_err());
+    }
+}
