+#[tokio::test]
+async fn a_registry_write_failure_reaches_the_mutation_caller_and_the_next_save_recovers() {
+    let (core, root) = test_core();
+    let terminal = {
+        let mut st = core.lock();
+        let id = st
+            .reg
+            .create(crate::terminals::NewTerminal { argv: vec!["sh".into()], ..Default::default() }, now_ms())
+            .unwrap();
+        crate::terminals::address(id)
+    };
+    core.flush_saved().await.unwrap();
+    let temp = core.paths.state.join("terminals.tmp");
+    std::fs::create_dir(&temp).unwrap();
+    let call = crate::api::Call { core: &core, conn: None, plain: None };
+    let error = crate::api::dispatch(&call, "terminal.label", json!({"terminal": terminal, "labels":{"audit":"changed"}}))
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind, "unavailable");
+    assert!(error.message.contains("in memory"));
+    let status = crate::api::dispatch(&call, "server.status", json!({})).await.unwrap();
+    assert!(status["registry_error"].is_string());
+    std::fs::remove_dir(&temp).unwrap();
+    let saved = crate::api::dispatch(&call, "terminal.label", json!({"terminal": terminal, "labels":{"disk":"recovered"}}))
+        .await
+        .unwrap();
+    assert_eq!(saved["labels"]["audit"], "changed");
+    let disk = std::fs::read_to_string(core.paths.state.join("terminals.json")).unwrap();
+    assert!(disk.contains("recovered"));
+    let status = crate::api::dispatch(&call, "server.status", json!({})).await.unwrap();
+    assert!(status.get("registry_error").is_none());
+    drop(core);
+    remove_root(&root);
+}
