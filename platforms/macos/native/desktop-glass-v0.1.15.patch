+        use gpui::WindowBackgroundAppearance;
+
+        let requested = self.layout_name == "workspace-folders"
+            && matches!(&self.chrome.background, Some(crate::layout::Background::Color(color)) if color == "#00000000");
+        let enabled = requested && !window.is_fullscreen() && !gpui_macos::reduce_transparency();
+        let appearance = if enabled { WindowBackgroundAppearance::Blurred } else { WindowBackgroundAppearance::Opaque };
+        if window.background_appearance() != appearance {
+            window.set_background_appearance(appearance);
+        }
+        enabled
+    }
